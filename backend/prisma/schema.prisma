generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("viewer") // admin, planner, viewer
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  plans     Plan[]   @relation("PlanCreator")
  scenarios Scenario[] @relation("ScenarioCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Car Flow Plan relations - plans committed by this user
  committedCarFlowPlans CarFlowPlan[] @relation("CarFlowPlanCommitter")

  // S&OP Commitment relations
  createdSOPCommitments  SOPCommitment[] @relation("SOPCommitmentCreator")
  updatedSOPCommitments  SOPCommitment[] @relation("SOPCommitmentUpdater")

  // Master Plan relations
  createdMasterPlans     MasterPlan[] @relation("MasterPlanCreator")
  submittedMasterPlans   MasterPlan[] @relation("MasterPlanSubmitter")
  approvedMasterPlans    MasterPlan[] @relation("MasterPlanApprover")

  // Master Plan Commitment relations
  committedMasterPlanCommitments  MasterPlanCommitment[] @relation("MasterPlanCommitmentCommitter")
  cancelledMasterPlanCommitments  MasterPlanCommitment[] @relation("MasterPlanCommitmentCanceller")

  // Unified Assignment relations
  committedUnifiedAssignments     UnifiedAssignment[] @relation("UnifiedAssignmentCommitter")
  cancelledUnifiedAssignments     UnifiedAssignment[] @relation("UnifiedAssignmentCanceller")
}

model Company {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  users       User[]
  cars        Car[]
  shops       Shop[]
  plans       Plan[]
  scenarios   Scenario[]
  shopRules   ShopRule[]
  customers   Customer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Lease Qualification Engine relations
  leaseContracts          LeaseContract[]
  qualificationEntries    LeaseQualificationEntry[]
  qualificationEvents     QualificationPlanEvent[]
  qualificationScenarios  QualificationScenario[]
  qualificationDocuments  QualificationPlanDocument[]

  // Car Flow Planning relations
  carFlowPlans            CarFlowPlan[]
  sopCommitments          SOPCommitment[]

  // Master Plan relations
  masterPlans             MasterPlan[]
  masterPlanCommitments   MasterPlanCommitment[]
  unifiedAssignments      UnifiedAssignment[]
}

// Customer master for tracking lessees/owners
model Customer {
  id           String   @id @default(uuid())
  name         String
  code         String   // Short code like "SHELL", "CARG"
  contactName  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  address      String   @default("")
  notes        String   @default("")
  isActive     Boolean  @default(true)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Car relations - cars belonging to this customer
  cars                 Car[]    @relation("CarCustomer")

  // Lease Qualification Engine relations
  leaseContracts       LeaseContract[]
  qualificationEntries LeaseQualificationEntry[]

  // Car Flow Plan relations
  carFlowPlans         CarFlowPlan[]

  // Scenario relations (multi-customer support)
  scenarioCustomers    ScenarioCustomer[]

  // Master Plan relations
  masterPlanCommitments MasterPlanCommitment[]
  unifiedAssignments    UnifiedAssignment[]

  @@unique([code, companyId])
}

model Car {
  id                       String           @id @default(uuid())
  railcarNumber            String           @unique // Railcar number/reporting mark (Mark + Number concatenated)
  carType                  String           @default("") // Car Type Level 2: Tank car, hopper, boxcar, gondola, etc.
  isTankCar                Boolean          @default(false) // Critical for shop qualification validation
  commodity                String           @default("") // Primary Commodity - What the car carries
  customer                 String           @default("") // Lessee Name - Customer/lessee name (legacy, use customerId)
  customerId               String?          // FK to Customer table (preferred over customer string)
  customerRef              Customer?        @relation("CarCustomer", fields: [customerId], references: [id])
  projectNumber            String           @default("") // Project or work order number
  reasonsShopped           String           @default("") // Reason(s) for shopping: qualification, repair, maintenance, etc.

  // Current Status - Values: Arrived, Complete, To Be Routed, Release, Up Marketed, Enroute, Reassigned, Released, Other
  status                   String           @default("To Be Routed")

  // Shopping Status - Computed field: Urgent, Must Shop, Upcoming, Compliant, In Shop, Planned, Unknown
  shoppingStatus           String           @default("Unknown")

  // Portfolio and Qualification flags
  portfolio                Boolean          @default(false) // Active lease - car is in customer's managed fleet
  performedTankQual        Boolean          @default(false) // Do we have to shop the car for Qual

  currentLocation          String           @default("") // Current physical location
  assignedShopId           String?          // Currently assigned shop (if in_shop or scheduled)
  projectedCompletionMonth String           @default("") // YYYY-MM format
  projectedCost            Float            @default(0) // Estimated cost for current/next service
  shopEntryDate            DateTime?        // When car entered current shop
  arrivalDate              DateTime?        // When car arrived at shop (from FMS data)
  daysInShop               Int              @default(0) // Calculated field for reporting
  lastServiceDate          DateTime?
  nextServiceDue           DateTime?
  homeRegion               String           @default("") // Preferred geographic region
  originRegion             String           @default("") // Origin region for logistics
  notes                    String           @default("")

  // New fields from car database specification
  contractNumber           String           @default("") // Contract number/reference
  contractExpiration       DateTime?        // Contract Expiration date
  isJacketed               Boolean          @default(false) // Jacketed tank car
  isLined                  Boolean          @default(false) // Lined tank car
  buildYear                Int?             // Year the car was built
  qualificationType        String           @default("") // Full/Partial Qual - "full" or "partial"
  tankQualified            Boolean          @default(false) // Tank Qualified flag
  performScheduled         Boolean          @default(false) // Perform Scheduled flag
  planStatus               String           @default("") // Plan Status

  // =============================================================================
  // REFERENCE FIELDS - Display in car info drawer (from Qual Planner Master CSV)
  // =============================================================================
  csr                      String           @default("") // Customer Service Rep
  csl                      String           @default("") // Customer Service Lead
  commercial               String           @default("") // Commercial contact
  liningType               String           @default("") // Lining Type (if lined)
  carMark                  String           @default("") // Car Mark prefix (for sister car sorting)
  carNumber                String           @default("") // Car Number suffix (for sister car sorting)
  fmsLesseeNumber          String           @default("") // FMS Lessee Number
  pastRegion               String           @default("") // Past Region
  region2026               String           @default("") // 2026 Region planning

  // =============================================================================
  // QUALIFICATION DATE FIELDS - These drive shopping urgency
  // The earliest due date across all determines shopping_status
  // =============================================================================
  minNoLining              DateTime?        // Minimum inspection (unlined cars) due date
  minWLining               DateTime?        // Minimum inspection (lined cars) due date
  interiorLining           DateTime?        // Interior lining inspection due date
  rule88B                  DateTime?        // Rule 88B compliance due date
  safetyRelief             DateTime?        // Safety relief valve due date
  serviceEquipment         DateTime?        // Service equipment inspection due date
  stubSill                 DateTime?        // Stub sill inspection due date
  tankThickness            DateTime?        // Tank thickness test due date
  tankQualification        DateTime?        // Full tank qualification due date

  companyId                String
  company                  Company          @relation(fields: [companyId], references: [id])
  assignments              PlanAssignment[]
  scenarioCars             ScenarioCar[]
  shopEligibilities        CarShopEligibility[] // Eligible shops for this car
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  // Lease Qualification Engine relations
  leaseContracts           LeaseContract[]
  qualificationEntries     LeaseQualificationEntry[]

  // Car Flow Plan relations - one active commitment per car
  carFlowPlan              CarFlowPlan?     @relation("CarFlowPlanCar")

  // Master Plan relations - one car can have multiple commitments across plans
  masterPlanCommitments    MasterPlanCommitment[]
  unifiedAssignments       UnifiedAssignment[]

  // Note: railcarNumber has @unique constraint for UPSERT operations
  // Compound constraint retained for multi-tenant compatibility
  @@index([railcarNumber, companyId])
  // Performance indexes for frequently filtered fields
  @@index([status])
  @@index([shoppingStatus])
  @@index([customer])
  @@index([companyId])
  @@index([customerId])
  @@index([portfolio])
  // Composite indexes for common filter combinations
  @@index([companyId, shoppingStatus, status])
  @@index([customerId, shoppingStatus])
}

model Shop {
  id                 String           @id @default(uuid())
  name               String
  code               String           @unique // Shop code as unique business key
  location           String
  city               String           @default("")
  state              String           @default("")
  region             String           @default("") // Geographic region: Northeast, Southeast, Midwest, Southwest, West
  network            String           @default("") // Shop network: e.g., "AITX-Own", "3rd Party"
  servingRailroad    String           @default("") // Primary serving railroad: UP, BNSF, CSX, NS, etc.

  // Parent/Child Shop Hierarchy (Network Structure)
  // isParent=true means this is a SHOP_NETWORK, children are SHOP_LOCATIONs
  parentShopId       String?          // Reference to parent shop (for network/group hierarchy)
  parentShop         Shop?            @relation("ShopHierarchy", fields: [parentShopId], references: [id])
  childShops         Shop[]           @relation("ShopHierarchy")
  isParent           Boolean          @default(false) // True if this is a network (parent) shop
  annualTargetVolume Int              @default(0)     // Annual target volume (for parent shops)
  isAitxInternal     Boolean          @default(false) // True for AITX-owned shops, false for 3P
  tankQualified      Boolean          @default(true) // Critical: Can this shop service tank cars?
  networkTier        Int              @default(5) // 1-5, lower = preferred (for 3P ranking)
  shopStatus         String           @default("active") // active, probation, inactive
  capacity           Int              @default(10) // Cars per month
  currentLoad        Int              @default(0) // Current month's assignments
  utilizationTarget  Float            @default(0.90) // Target utilization (e.g., 0.90 = 90%)
  baseCostPerCar     Float            @default(15000) // Base cost per car
  laborRate          Float            @default(75.0) // Hourly labor rate
  costIndex          Float            @default(1.0) // Cost index (1.0 = 3P baseline, 1.379 = AITX premium)
  baseTurnTime       Int              @default(14) // Base turn time in days
  turnTimeMultiplier Float            @default(1.0)
  capabilities       String           @default("") // JSON array of car types this shop can handle
  certifications     String           @default("") // JSON array: DOT, AAR, etc.
  preferredCustomers String           @default("") // JSON array of preferred customer codes
  contactName        String           @default("")
  contactEmail       String           @default("")
  contactPhone       String           @default("")
  notes              String           @default("")
  isActive           Boolean          @default(true)
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  assignments        PlanAssignment[]
  carEligibilities   CarShopEligibility[] // Cars eligible for this shop
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // S&OP capacity fields
  qualCapacity       Int              @default(50)  // Monthly qualification capacity
  assignCapacity     Int              @default(30)  // Monthly assignment capacity
  returnCapacity     Int              @default(40)  // Monthly return capacity
  repairCapacity     Int              @default(20)  // Monthly repair capacity
  efficiencyRating   Float            @default(0.9) // Shop efficiency (0.0 to 1.0)

  // S&OP Relations
  capacitySlots      ShopCapacitySlot[]

  // Lease Qualification Engine relations
  qualificationEntries LeaseQualificationEntry[]

  // Car Flow Plan relations
  carFlowPlans         CarFlowPlan[]
  sopCommitments       SOPCommitment[]

  // Gold Standard relations
  weeklyCapacities     WeeklyCapacity[]

  // Master Plan relations
  masterPlanCommitments MasterPlanCommitment[]
  unifiedAssignments    UnifiedAssignment[]

  // Shop Capability Profile (shop-first constraints)
  capabilityProfile     ShopCapabilityProfile?

  // Note: code has @unique constraint for UPSERT operations
  // Compound constraint retained for multi-tenant compatibility
  @@index([code, companyId])
  @@index([parentShopId])
  // Performance indexes for frequently filtered fields
  @@index([region])
  @@index([companyId])
  @@index([isActive])
  @@index([isParent])
}

// =============================================================================
// SHOP CAPABILITY PROFILE - Shop-First Constraints for S&OP Planning
// =============================================================================
// Defines what work a shop CAN perform (certifications) and what cars it CAN
// handle (physical limits, hazmat, customer restrictions). This inverts the
// traditional model where rules are assigned to cars - now shops declare their
// capabilities and the allocation engine validates against them.
// =============================================================================

model ShopCapabilityProfile {
  id                          String   @id @default(uuid())
  shopId                      String   @unique
  shop                        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // ==========================================================================
  // CERTIFICATIONS - What work types this shop can perform
  // ==========================================================================
  canPerformTankLining        Boolean  @default(false)  // Tank lining repairs/inspections
  canPerformAnnualQuals       Boolean  @default(false)  // Annual qualification testing
  canPerformRule88B           Boolean  @default(false)  // Rule 88B compliance work
  canPerformSafetyRelief      Boolean  @default(false)  // Safety relief valve service
  canPerformStubSill          Boolean  @default(false)  // Stub sill inspections
  canPerformTankThickness     Boolean  @default(false)  // Tank thickness testing
  canPerformFullQualification Boolean  @default(true)   // Full tank qualification
  canPerformPartialQual       Boolean  @default(true)   // Partial qualification
  canPerformRepairs           Boolean  @default(true)   // General repairs
  canPerformServiceEquipment  Boolean  @default(false)  // Service equipment inspection

  // ==========================================================================
  // PHYSICAL LIMITS - What car types/sizes this shop can handle
  // ==========================================================================
  allowedAssetClasses         String   @default("[]")   // JSON: ["Tank", "Hopper", "Boxcar", "Gondola"]
  maxCarLength                Int?                       // Maximum car length in feet (null = no limit)
  maxCarWeight                Int?                       // Maximum car weight in tons (null = no limit)
  hasJacketedCarSupport       Boolean  @default(true)   // Can handle jacketed tank cars
  hasLinedCarSupport          Boolean  @default(true)   // Can handle lined tank cars
  allowedLiningTypes          String   @default("[]")   // JSON: ["Rubber", "Epoxy", "Glass"] - empty = all

  // ==========================================================================
  // HAZARDOUS MATERIAL RESTRICTIONS
  // ==========================================================================
  hazmatCertifications        String   @default("[]")   // JSON: DOT specs shop is certified for
  restrictedCommodities       String   @default("[]")   // JSON: commodities NOT allowed at this shop
  allowedCommodities          String   @default("[]")   // JSON: commodities explicitly allowed (empty = all)

  // ==========================================================================
  // CUSTOMER RESTRICTIONS
  // ==========================================================================
  preferredCustomers          String   @default("[]")   // JSON: customer codes with priority treatment
  excludedCustomers           String   @default("[]")   // JSON: customers NOT served by this shop
  isContractShop              Boolean  @default(false)  // Dedicated to specific customers only

  // ==========================================================================
  // CAPACITY CONSTRAINTS
  // ==========================================================================
  monthlyCapacity             Int      @default(50)     // Cars per month
  maxConcurrentCars           Int      @default(10)     // Max cars in shop at once
  preferredWorkloadMix        String   @default("{}")   // JSON: { "qualification": 60, "repair": 40 } %

  // ==========================================================================
  // 3RD PARTY COMMITMENT TRACKING (for S&OP Supply)
  // ==========================================================================
  hasContractualCommitment    Boolean  @default(false)  // Take-or-pay obligation
  annualCommittedVolume       Int      @default(0)      // Annual cars committed
  commitmentPenaltyRate       Float    @default(0)      // $/car penalty for under-utilization

  // ==========================================================================
  // AUDIT FIELDS
  // ==========================================================================
  companyId                   String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([shopId])
  @@index([companyId])
  @@index([hasContractualCommitment])
}

// Junction table for Car-Shop eligibility (shop checkboxes in car database)
// Maps to columns: Sarnia, Kansas City, Mounds, LaPorte, AITX Fleet Services, etc.
model CarShopEligibility {
  id          String   @id @default(uuid())
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  isEligible  Boolean  @default(true) // Whether this car is eligible for this shop
  notes       String   @default("")   // Optional notes about eligibility
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([carId, shopId])
  @@index([carId])
  @@index([shopId])
}

// Rule engine for shop recommendations
model ShopRule {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  ruleType    String   // capacity, region, car_type, customer, cost, turn_time
  priority    Int      @default(50) // 1-100, higher = more important
  isActive    Boolean  @default(true)
  conditions  String   // JSON: conditions to match
  actions     String   // JSON: what to do when matched (prefer_shop, exclude_shop, adjust_score)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Performance indexes
  @@index([companyId])
  @@index([isActive])
  @@index([ruleType])
  @@index([priority])
}

model Plan {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  startDate   DateTime
  endDate     DateTime
  status      String           @default("draft") // draft, active, completed, archived
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  createdBy   String
  creator     User             @relation("PlanCreator", fields: [createdBy], references: [id])
  assignments PlanAssignment[]
  scenarios   Scenario[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Performance indexes
  @@index([companyId])
  @@index([status])
  @@index([createdBy])
  @@index([startDate])
  @@index([endDate])
}

model PlanAssignment {
  id                String   @id @default(uuid())
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  carId             String
  car               Car      @relation(fields: [carId], references: [id])
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id])
  scheduledMonth    String   // Format: YYYY-MM
  estimatedCost     Float    @default(0)
  estimatedDuration Int      @default(14) // days
  status            String   @default("pending") // pending, confirmed, in_progress, completed, cancelled
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([planId, carId, scheduledMonth])
  // Performance indexes for common query patterns
  @@index([planId])
  @@index([carId])
  @@index([shopId])
  @@index([scheduledMonth])
  @@index([status])
  @@index([shopId, scheduledMonth])
  // Composite index for planning grid performance (primary query optimization)
  @@index([planId, scheduledMonth])
}

// =============================================================================
// SCENARIO & CAR FLOW PLANNING MODELS
// =============================================================================

model Scenario {
  id             String                 @id @default(uuid())
  name           String                 // Scenario Name: e.g., "Poet Biofuels Q1 2026"
  description    String                 @default("")
  notes          String                 @default("") // Optional notes for the scenario

  // Status: draft, confirmed, archived
  status         String                 @default("draft")
  confirmedAt    DateTime?              // When the scenario was confirmed to Car Flow Plan

  // Legacy fields (kept for backward compatibility)
  projectNumber  String                 @default("") // Optional project number
  customerFilter String                 @default("") // Legacy: Filter by customer
  basePlanId     String?                // Optional base plan
  basePlan       Plan?                  @relation(fields: [basePlanId], references: [id])

  // Scenario cars
  cars           ScenarioCar[]
  modifications  ScenarioModification[]
  results        String?                // JSON string for results

  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  createdBy      String
  creator        User                   @relation("ScenarioCreator", fields: [createdBy], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // S&OP Scenario fields
  isBaseline     Boolean                @default(false) // Is this the baseline scenario?
  parentId       String?                // For cloned scenarios

  // Draft Mode (Sandbox) Support
  isDraft              Boolean          @default(false) // True if this is a sandbox scenario
  draftExpiresAt       DateTime?        // When the draft auto-expires (cleanup)
  parentMasterPlanId   String?          // Master plan this draft is based on
  draftKpiSnapshot     String           @default("{}") // JSON: Real-time KPI state in draft mode
  parent         Scenario?              @relation("ScenarioClones", fields: [parentId], references: [id])
  clones         Scenario[]             @relation("ScenarioClones")

  // Multi-customer support (junction table)
  customers      ScenarioCustomer[]

  // Car Flow Plan relation - scenarios that created car flow plans
  carFlowPlans   CarFlowPlan[]

  @@index([projectNumber, companyId])
  // Performance indexes for frequently filtered fields
  @@index([status])
  @@index([companyId])
  @@index([createdBy])
}

// Junction table for Scenario-Customer relationship (multi-customer scenarios)
model ScenarioCustomer {
  id          String   @id @default(uuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  isPrimary   Boolean  @default(false) // Primary customer for the scenario
  createdAt   DateTime @default(now())

  @@unique([scenarioId, customerId])
  @@index([scenarioId])
  @@index([customerId])
}

// Cars selected for a scenario with shop assignment
model ScenarioCar {
  id              String   @id @default(uuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  carId           String
  car             Car      @relation(fields: [carId], references: [id])

  // Shop assignment
  shopId          String?  // Planned shop (location_id in spec)
  suggestedShopId String?  // Shop suggested by rule engine (legacy)

  // Planning period
  plannedMonth    Int      // 1-12
  plannedYear     Int      // e.g., 2026
  scheduledMonth  String   @default("") // Legacy: YYYY-MM format (deprecated, use plannedMonth/Year)

  // Shopping reason - why this car needs shopping (derived from qualification)
  shopReason      String   @default("") // e.g., "Tank Qualification Due", "Rule 88B Due"

  // Cost and duration estimates
  estimatedCost   Float    @default(0)
  estimatedDays   Int      @default(14)

  // Rule engine scoring (legacy)
  ruleScore       Float    @default(0)
  ruleNotes       String   @default("")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scenarioId, carId])
  // Performance indexes
  @@index([scenarioId])
  @@index([carId])
  @@index([shopId])
  @@index([plannedYear, plannedMonth])
}

model ScenarioModification {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  type       String   // add_assignment, remove_assignment, modify_assignment, change_shop, change_date
  targetId   String
  changes    String   // JSON string for changes
  createdAt  DateTime @default(now())
}

// =============================================================================
// CAR FLOW PLAN - Source of Truth for Committed Assignments
// =============================================================================
// This is THE authoritative table for committed car-to-shop assignments
// A car can only have ONE active commitment (status != 'Cancelled')
// =============================================================================

model CarFlowPlan {
  id              String    @id @default(uuid())

  // Car assignment (one active per car)
  carId           String    @unique // One active commitment per car
  car             Car       @relation("CarFlowPlanCar", fields: [carId], references: [id])

  // Shop where work will be performed
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id])

  // Customer (for reporting/grouping)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  // Planning period
  plannedMonth    Int       // 1-12
  plannedYear     Int       // e.g., 2026

  // Source scenario for audit trail
  sourceScenarioId String?
  sourceScenario   Scenario? @relation(fields: [sourceScenarioId], references: [id])

  // Commitment tracking
  committedAt     DateTime  @default(now())
  committedById   String
  committedBy     User      @relation("CarFlowPlanCommitter", fields: [committedById], references: [id])

  // Status workflow: Planned → In Progress → Complete, Cancelled
  // - Planned: Committed to the plan, not yet started
  // - In Progress: Car has arrived at shop (status = 'Arrived')
  // - Complete: Work finished (car status = 'Complete')
  // - Cancelled: Removed from plan (soft delete, capacity restored)
  status          String    @default("Planned")

  // Shop reason (why this car needs shopping)
  shopReason      String    @default("")

  // Cost estimates
  estimatedCost   Float?

  // Priority: 1=CRITICAL, 2=HIGH, 3=MEDIUM, 4=LOW
  priority        Int       @default(3)

  notes           String    @default("")

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime? // When the plan was cancelled (for soft delete)

  // Indexes for performance
  @@index([shopId, plannedYear, plannedMonth])
  @@index([customerId])
  @@index([status])
  @@index([companyId])
  @@index([sourceScenarioId])
  @@index([plannedYear, plannedMonth])
}

// =============================================================================
// S&OP SUPPLY COMMITMENT
// =============================================================================
// Monthly committed volume by shop location
// This is separate from shop capacity - it's the negotiated/agreed capacity
// =============================================================================

model SOPCommitment {
  id              String   @id @default(uuid())

  // Shop location (not network/parent)
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id])

  // Period
  year            Int      // e.g., 2026
  month           Int      // 1-12

  // Committed volume - cars committed to this shop for this month
  committedVolume Int      @default(0)

  // Current usage (updated when CarFlowPlan entries are created/cancelled)
  currentUsage    Int      @default(0)

  // Audit fields
  createdById     String
  createdBy       User     @relation("SOPCommitmentCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?    @relation("SOPCommitmentUpdater", fields: [updatedById], references: [id])

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shopId, year, month])
  @@index([shopId, year])
  @@index([companyId, year, month])
}

// Audit log for tracking all data changes
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userEmail   String
  action      String   // create, update, delete, commit, assign, export, confirm_scenario
  entityType  String   // Car, Shop, Plan, PlanAssignment, Scenario, CarFlowPlan, SOPCommitment
  entityId    String
  entityName  String   @default("") // Human-readable name for the entity
  changes     String   // JSON: { field: { old: value, new: value } }
  metadata    String   @default("{}") // Additional context as JSON
  ipAddress   String   @default("")
  userAgent   String   @default("")
  companyId   String
  createdAt   DateTime @default(now())

  @@index([companyId, entityType, createdAt])
  @@index([userId, createdAt])
}

// Role-based permissions configuration
model RolePermission {
  id           String   @id @default(uuid())
  role         String   // admin, planner, viewer, approver, finance
  permission   String   // entity:action format (e.g., "plan:commit", "shop:edit", "cost:view", "sop:edit")
  isGranted    Boolean  @default(true)
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([role, permission, companyId])
}

// Field-level security configuration
model FieldSecurity {
  id            String   @id @default(uuid())
  entityType    String   // Shop, Car, Plan, etc.
  fieldName     String   // laborRate, projectedCost, etc.
  visibleRoles  String   // JSON array of roles that can view
  editableRoles String   // JSON array of roles that can edit
  maskType      String   @default("hidden") // hidden, masked, readonly
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, fieldName, companyId])
}

// Shop performance metrics (calculated periodically)
model ShopPerformance {
  id                   String   @id @default(uuid())
  shopId               String
  periodStart          DateTime // Start of measurement period
  periodEnd            DateTime // End of measurement period
  periodType           String   @default("monthly") // monthly, quarterly, yearly

  // Turn Time / MTTR metrics
  averageTurnTime      Float    @default(0) // Average days from arrival to release
  turnTimeByRepairType String   @default("{}") // JSON: { "qualification": 12, "repair": 18 }

  // On-Time Performance (OTP)
  totalCompleted       Int      @default(0)
  onTimeCompleted      Int      @default(0)
  onTimeRate           Float    @default(0) // Percentage 0-100

  // Dwell Time
  averageDwellTime     Float    @default(0) // Days waiting before work begins

  // Quality metrics
  totalReleased        Int      @default(0)
  reworkCount          Int      @default(0)
  reworkRate           Float    @default(0) // Percentage of cars returning within 90 days

  // Cost metrics
  totalEstimatedCost   Float    @default(0)
  totalActualCost      Float    @default(0)
  costVariance         Float    @default(0) // Percentage difference (positive = over budget)

  // Composite score (weighted calculation)
  performanceScore     Float    @default(0) // 0-100 weighted score

  companyId            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shopId, periodStart, periodEnd, periodType])
  @@index([shopId, periodType, createdAt])
}

// Custom report templates
model ReportTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  entityType      String   // Car, Shop, Plan, Assignment, Scenario, CarFlowPlan
  columns         String   // JSON array of column definitions
  filters         String   @default("[]") // JSON array of saved filter criteria
  sortConfig      String   @default("{}") // JSON: { field, direction }
  groupBy         String   @default("") // Optional grouping field
  outputFormats   String   @default("[\"csv\"]") // JSON array: ["csv", "pdf", "xlsx"]
  isPublic        Boolean  @default(false) // Shared with all company users
  createdById     String
  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Scheduled report jobs
model ScheduledReport {
  id              String    @id @default(uuid())
  name            String
  templateId      String
  schedule        String    // Cron expression: "0 8 * * 1" = 8AM every Monday
  timezone        String    @default("America/Chicago")
  outputFormat    String    @default("pdf") // pdf, csv, xlsx
  recipients      String    // JSON array of email addresses
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String    @default("pending") // pending, success, failed
  lastRunError    String    @default("")
  createdById     String
  companyId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// =============================================================================
// S&OP SCHEDULER MODELS (Legacy - kept for backward compatibility)
// =============================================================================

// Shop capacity tracking by month and slot type
model ShopCapacitySlot {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])
  monthKey    String // "2026-03"
  slotType    String // "qualification", "assignment", "return", "repair"
  capacity    Int    // Total capacity for this slot type
