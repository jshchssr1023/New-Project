generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("viewer") // admin, planner, viewer
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  plans     Plan[]   @relation("PlanCreator")
  scenarios Scenario[] @relation("ScenarioCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  users       User[]
  cars        Car[]
  shops       Shop[]
  plans       Plan[]
  scenarios   Scenario[]
  shopRules   ShopRule[]
  customers   Customer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Customer master for tracking lessees/owners
model Customer {
  id           String   @id @default(uuid())
  name         String
  code         String   // Short code like "SHELL", "CARG"
  contactName  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  address      String   @default("")
  notes        String   @default("")
  isActive     Boolean  @default(true)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([code, companyId])
}

model Car {
  id                      String           @id @default(uuid())
  vehicleNumber           String           // Railcar number/reporting mark
  carType                 String           @default("") // Tank car, hopper, boxcar, gondola, etc.
  isTankCar               Boolean          @default(false) // Critical for shop qualification validation
  commodity               String           @default("") // What the car carries
  customer                String           @default("") // Customer/lessee name
  projectNumber           String           @default("") // Project or work order number
  reasonShopped           String           @default("") // Why car is being shopped: qualification, assignment, return, repair
  status                  String           @default("available") // available, in_service, in_shop, scheduled, retired
  currentLocation         String           @default("") // Current physical location
  assignedShopId          String?          // Currently assigned shop (if in_shop or scheduled)
  projectedCompletionMonth String          @default("") // YYYY-MM format
  projectedCost           Float            @default(0) // Estimated cost for current/next service
  shopEntryDate           DateTime?        // When car entered current shop
  daysInShop              Int              @default(0) // Calculated field for reporting
  lastServiceDate         DateTime?
  nextServiceDue          DateTime?
  homeRegion              String           @default("") // Preferred geographic region
  originRegion            String           @default("") // Origin region for logistics
  notes                   String           @default("")
  companyId               String
  company                 Company          @relation(fields: [companyId], references: [id])
  assignments             PlanAssignment[]
  scenarioCars            ScenarioCar[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([vehicleNumber, companyId])
}

model Shop {
  id                 String           @id @default(uuid())
  name               String
  code               String
  location           String
  city               String           @default("")
  state              String           @default("")
  region             String           @default("") // Geographic region: Northeast, Southeast, Midwest, Southwest, West
  network            String           @default("") // Shop network: e.g., "AITX-Own", "3rd Party"
  servingRailroad    String           @default("") // Primary serving railroad: UP, BNSF, CSX, NS, etc.
  isAitxInternal     Boolean          @default(false) // True for AITX-owned shops, false for 3P
  tankQualified      Boolean          @default(true) // Critical: Can this shop service tank cars?
  networkTier        Int              @default(5) // 1-5, lower = preferred (for 3P ranking)
  shopStatus         String           @default("active") // active, probation, inactive
  capacity           Int              @default(10) // Cars per month
  currentLoad        Int              @default(0) // Current month's assignments
  utilizationTarget  Float            @default(0.90) // Target utilization (e.g., 0.90 = 90%)
  baseCostPerCar     Float            @default(15000) // Base cost per car
  laborRate          Float            @default(75.0) // Hourly labor rate
  costIndex          Float            @default(1.0) // Cost index (1.0 = 3P baseline, 1.379 = AITX premium)
  baseTurnTime       Int              @default(14) // Base turn time in days
  turnTimeMultiplier Float            @default(1.0)
  capabilities       String           @default("") // JSON array of car types this shop can handle
  certifications     String           @default("") // JSON array: DOT, AAR, etc.
  preferredCustomers String           @default("") // JSON array of preferred customer codes
  contactName        String           @default("")
  contactEmail       String           @default("")
  contactPhone       String           @default("")
  notes              String           @default("")
  isActive           Boolean          @default(true)
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  assignments        PlanAssignment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([code, companyId])
}

// Rule engine for shop recommendations
model ShopRule {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  ruleType    String   // capacity, region, car_type, customer, cost, turn_time
  priority    Int      @default(50) // 1-100, higher = more important
  isActive    Boolean  @default(true)
  conditions  String   // JSON: conditions to match
  actions     String   // JSON: what to do when matched (prefer_shop, exclude_shop, adjust_score)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  startDate   DateTime
  endDate     DateTime
  status      String           @default("draft") // draft, active, completed, archived
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  createdBy   String
  creator     User             @relation("PlanCreator", fields: [createdBy], references: [id])
  assignments PlanAssignment[]
  scenarios   Scenario[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PlanAssignment {
  id                String   @id @default(uuid())
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  carId             String
  car               Car      @relation(fields: [carId], references: [id])
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id])
  scheduledMonth    String   // Format: YYYY-MM
  estimatedCost     Float    @default(0)
  estimatedDuration Int      @default(14) // days
  status            String   @default("pending") // pending, confirmed, in_progress, completed, cancelled
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([planId, carId, scheduledMonth])
}

model Scenario {
  id            String                 @id @default(uuid())
  name          String
  description   String                 @default("")
  customerFilter String                @default("") // Filter by customer
  basePlanId    String?                // Optional base plan
  basePlan      Plan?                  @relation(fields: [basePlanId], references: [id])
  status        String                 @default("draft") // draft, analyzing, completed
  cars          ScenarioCar[]
  modifications ScenarioModification[]
  results       String?                // JSON string for results
  companyId     String
  company       Company                @relation(fields: [companyId], references: [id])
  createdBy     String
  creator       User                   @relation("ScenarioCreator", fields: [createdBy], references: [id])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

// Cars selected for a scenario
model ScenarioCar {
  id              String   @id @default(uuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  carId           String
  car             Car      @relation(fields: [carId], references: [id])
  suggestedShopId String?  // Shop suggested by rule engine
  assignedShopId  String?  // Shop manually assigned
  scheduledMonth  String   // Planned month YYYY-MM
  estimatedCost   Float    @default(0)
  estimatedDays   Int      @default(14)
  ruleScore       Float    @default(0) // Score from rule engine
  ruleNotes       String   @default("") // Explanation of suggestion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scenarioId, carId])
}

model ScenarioModification {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  type       String   // add_assignment, remove_assignment, modify_assignment, change_shop, change_date
  targetId   String
  changes    String   // JSON string for changes
  createdAt  DateTime @default(now())
}
