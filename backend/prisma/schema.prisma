// Integration Log - API/Webhook monitoring for Car Flow Plan publication
model IntegrationLog {
  id              String    @id @default(uuid())

  // Integration details
  integrationType String    // webhook, api_call, data_sync
  endpoint        String    // URL or endpoint called
  method          String    // POST, PUT, GET, etc.

  // Request/Response
  requestPayload  String    @default("{}") // JSON: request body (sanitized)
  responseStatus  Int       // HTTP status code
  responseBody    String    @default("{}") // JSON: response body (sanitized)

  // Timing
  startedAt       DateTime
  completedAt     DateTime?
  durationMs      Int       @default(0)

  // Status
  status          String    @default("pending") // pending, success, failed, timeout, retrying
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  errorMessage    String    @default("")

  // Context
  triggerAction   String    // car_flow_plan_confirm, scenario_export, capacity_change
  entityType      String    // CarFlowPlan, Scenario, SOPCommitment
  entityId        String

  // Who triggered
  triggeredById   String?
  triggeredByEmail String   @default("")

  companyId       String
  createdAt       DateTime  @default(now())

  @@index([companyId, integrationType, createdAt])
  @@index([entityType, entityId])
  @@index([status, createdAt])
