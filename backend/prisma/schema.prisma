generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("viewer") // admin, planner, viewer
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  plans     Plan[]   @relation("PlanCreator")
  scenarios Scenario[] @relation("ScenarioCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // MasterPlan relations - plans approved by this user
  approvedMasterPlans MasterPlan[] @relation("MasterPlanApprover")
}

model Company {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  users       User[]
  cars        Car[]
  shops       Shop[]
  plans       Plan[]
  scenarios   Scenario[]
  shopRules   ShopRule[]
  customers   Customer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Lease Qualification Engine relations
  leaseContracts          LeaseContract[]
  qualificationEntries    LeaseQualificationEntry[]
  qualificationEvents     QualificationPlanEvent[]
  qualificationScenarios  QualificationScenario[]
  qualificationDocuments  QualificationPlanDocument[]

  // MasterPlan relations
  masterPlans             MasterPlan[]
}

// Customer master for tracking lessees/owners
model Customer {
  id           String   @id @default(uuid())
  name         String
  code         String   // Short code like "SHELL", "CARG"
  contactName  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  address      String   @default("")
  notes        String   @default("")
  isActive     Boolean  @default(true)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Car relations - cars belonging to this customer
  cars                 Car[]    @relation("CarCustomer")

  // Lease Qualification Engine relations
  leaseContracts       LeaseContract[]
  qualificationEntries LeaseQualificationEntry[]

  // MasterPlan relations
  masterCommitments    MasterPlanCommitment[]

  @@unique([code, companyId])
}

model Car {
  id                       String           @id @default(uuid())
  railcarNumber            String           @unique // Railcar number/reporting mark (Mark + Number concatenated)
  carType                  String           @default("") // Car Type Level 2: Tank car, hopper, boxcar, gondola, etc.
  isTankCar                Boolean          @default(false) // Critical for shop qualification validation
  commodity                String           @default("") // Primary Commodity - What the car carries
  customer                 String           @default("") // Lessee Name - Customer/lessee name (legacy, use customerId)
  customerId               String?          // FK to Customer table (preferred over customer string)
  customerRef              Customer?        @relation("CarCustomer", fields: [customerId], references: [id])
  projectNumber            String           @default("") // Project or work order number
  reasonsShopped           String           @default("") // Reason(s) for shopping: qualification, repair, maintenance, etc.
  status                   String           @default("available") // Current Status: available, in_service, in_shop, scheduled, retired, planned, release, assignment, arrived
  currentLocation          String           @default("") // Current physical location
  assignedShopId           String?          // Currently assigned shop (if in_shop or scheduled)
  projectedCompletionMonth String           @default("") // YYYY-MM format
  projectedCost            Float            @default(0) // Estimated cost for current/next service
  shopEntryDate            DateTime?        // When car entered current shop
  arrivalDate              DateTime?        // When car arrived at shop (from FMS data)
  daysInShop               Int              @default(0) // Calculated field for reporting
  lastServiceDate          DateTime?
  nextServiceDue           DateTime?
  homeRegion               String           @default("") // Preferred geographic region
  originRegion             String           @default("") // Origin region for logistics
  notes                    String           @default("")

  // New fields from car database specification
  contractNumber           String           @default("") // Contract number/reference
  contractExpiration       DateTime?        // Contract Expiration date
  isJacketed               Boolean          @default(false) // Jacketed tank car
  isLined                  Boolean          @default(false) // Lined tank car
  buildYear                Int?             // Year the car was built
  qualificationType        String           @default("") // Full/Partial Qual - "full" or "partial"
  tankQualified            Boolean          @default(false) // Tank Qualified flag
  tankQualDueDate          DateTime?        // Tank qualification due date
  performScheduled         Boolean          @default(false) // Perform Scheduled flag
  planStatus               String           @default("") // Plan Status

  companyId                String
  company                  Company          @relation(fields: [companyId], references: [id])
  assignments              PlanAssignment[]
  scenarioCars             ScenarioCar[]
  sopAssignments           SOPAssignment[]  // S&OP shop assignments
  shopEligibilities        CarShopEligibility[] // Eligible shops for this car
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  // Lease Qualification Engine relations
  leaseContracts           LeaseContract[]
  qualificationEntries     LeaseQualificationEntry[]

  // MasterPlan relations
  masterCommitments        MasterPlanCommitment[]

  // Note: railcarNumber has @unique constraint for UPSERT operations
  // Compound constraint retained for multi-tenant compatibility
  @@index([railcarNumber, companyId])
  // Performance indexes for frequently filtered fields
  @@index([status])
  @@index([customer])
  @@index([companyId])
  @@index([customerId])
}

model Shop {
  id                 String           @id @default(uuid())
  name               String
  code               String           @unique // Shop code as unique business key
  location           String
  city               String           @default("")
  state              String           @default("")
  region             String           @default("") // Geographic region: Northeast, Southeast, Midwest, Southwest, West
  network            String           @default("") // Shop network: e.g., "AITX-Own", "3rd Party"
  servingRailroad    String           @default("") // Primary serving railroad: UP, BNSF, CSX, NS, etc.

  // Parent/Child Shop Hierarchy
  parentShopId       String?          // Reference to parent shop (for network/group hierarchy)
  parentShop         Shop?            @relation("ShopHierarchy", fields: [parentShopId], references: [id])
  childShops         Shop[]           @relation("ShopHierarchy")
  isParent           Boolean          @default(false) // True if this is a parent/network shop
  annualTargetVolume Int              @default(0)     // Annual target volume (for parent shops)
  isAitxInternal     Boolean          @default(false) // True for AITX-owned shops, false for 3P
  tankQualified      Boolean          @default(true) // Critical: Can this shop service tank cars?
  networkTier        Int              @default(5) // 1-5, lower = preferred (for 3P ranking)
  shopStatus         String           @default("active") // active, probation, inactive
  capacity           Int              @default(10) // Cars per month
  currentLoad        Int              @default(0) // Current month's assignments
  utilizationTarget  Float            @default(0.90) // Target utilization (e.g., 0.90 = 90%)
  baseCostPerCar     Float            @default(15000) // Base cost per car
  laborRate          Float            @default(75.0) // Hourly labor rate
  costIndex          Float            @default(1.0) // Cost index (1.0 = 3P baseline, 1.379 = AITX premium)
  baseTurnTime       Int              @default(14) // Base turn time in days
  turnTimeMultiplier Float            @default(1.0)
  capabilities       String           @default("") // JSON array of car types this shop can handle
  certifications     String           @default("") // JSON array: DOT, AAR, etc.
  preferredCustomers String           @default("") // JSON array of preferred customer codes
  contactName        String           @default("")
  contactEmail       String           @default("")
  contactPhone       String           @default("")
  notes              String           @default("")
  isActive           Boolean          @default(true)
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  assignments        PlanAssignment[]
  carEligibilities   CarShopEligibility[] // Cars eligible for this shop
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // S&OP capacity fields
  qualCapacity       Int              @default(50)  // Monthly qualification capacity
  assignCapacity     Int              @default(30)  // Monthly assignment capacity
  returnCapacity     Int              @default(40)  // Monthly return capacity
  repairCapacity     Int              @default(20)  // Monthly repair capacity
  efficiencyRating   Float            @default(0.9) // Shop efficiency (0.0 to 1.0)

  // S&OP Relations
  capacitySlots      ShopCapacitySlot[]
  sopAssignments     SOPAssignment[]

  // Lease Qualification Engine relations
  qualificationEntries LeaseQualificationEntry[]

  // MasterPlan relations
  masterCommitments    MasterPlanCommitment[]

  // Gold Standard relations
  weeklyCapacities     WeeklyCapacity[]

  // Note: code has @unique constraint for UPSERT operations
  // Compound constraint retained for multi-tenant compatibility
  @@index([code, companyId])
  @@index([parentShopId])
  // Performance indexes for frequently filtered fields
  @@index([region])
  @@index([companyId])
  @@index([isActive])
}

// Junction table for Car-Shop eligibility (shop checkboxes in car database)
// Maps to columns: Sarnia, Kansas City, Mounds, LaPorte, AITX Fleet Services, etc.
model CarShopEligibility {
  id          String   @id @default(uuid())
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  isEligible  Boolean  @default(true) // Whether this car is eligible for this shop
  notes       String   @default("")   // Optional notes about eligibility
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([carId, shopId])
  @@index([carId])
  @@index([shopId])
}

// Rule engine for shop recommendations
model ShopRule {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  ruleType    String   // capacity, region, car_type, customer, cost, turn_time
  priority    Int      @default(50) // 1-100, higher = more important
  isActive    Boolean  @default(true)
  conditions  String   // JSON: conditions to match
  actions     String   // JSON: what to do when matched (prefer_shop, exclude_shop, adjust_score)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  startDate   DateTime
  endDate     DateTime
  status      String           @default("draft") // draft, active, completed, archived
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  createdBy   String
  creator     User             @relation("PlanCreator", fields: [createdBy], references: [id])
  assignments PlanAssignment[]
  scenarios   Scenario[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PlanAssignment {
  id                String   @id @default(uuid())
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  carId             String
  car               Car      @relation(fields: [carId], references: [id])
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id])
  scheduledMonth    String   // Format: YYYY-MM
  estimatedCost     Float    @default(0)
  estimatedDuration Int      @default(14) // days
  status            String   @default("pending") // pending, confirmed, in_progress, completed, cancelled
  notes             String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([planId, carId, scheduledMonth])
}

model Scenario {
  id             String                 @id @default(uuid())
  projectNumber  String                 // Required: e.g., Q4-25-001 (replaces Plan ID)
  name           String                 // Scenario Name: e.g., "Initial Proposal", "Revised Budget Plan"
  description    String                 @default("")
  customerFilter String                 @default("") // Filter by customer
  basePlanId     String?                // Optional base plan
  basePlan       Plan?                  @relation(fields: [basePlanId], references: [id])
  status         String                 @default("draft") // draft, analyzing, completed
  cars           ScenarioCar[]
  modifications  ScenarioModification[]
  results        String?                // JSON string for results
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  createdBy      String
  creator        User                   @relation("ScenarioCreator", fields: [createdBy], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // S&OP Scenario fields
  isBaseline     Boolean                @default(false) // Is this the baseline scenario?
  parentId       String?                // For cloned scenarios
  parent         Scenario?              @relation("ScenarioClones", fields: [parentId], references: [id])
  clones         Scenario[]             @relation("ScenarioClones")
  sopAssignments SOPAssignment[]        // S&OP shop assignments

  // MasterPlan relations - scenarios used as base for master plans
  masterPlans    MasterPlan[]

  @@index([projectNumber, companyId])
  // Performance indexes for frequently filtered fields
  @@index([status])
  @@index([companyId])
}

// Cars selected for a scenario
model ScenarioCar {
  id              String   @id @default(uuid())
  scenarioId      String
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  carId           String
  car             Car      @relation(fields: [carId], references: [id])
  suggestedShopId String?  // Shop suggested by rule engine
  assignedShopId  String?  // Shop manually assigned
  scheduledMonth  String   // Planned month YYYY-MM
  estimatedCost   Float    @default(0)
  estimatedDays   Int      @default(14)
  ruleScore       Float    @default(0) // Score from rule engine
  ruleNotes       String   @default("") // Explanation of suggestion
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scenarioId, carId])
}

model ScenarioModification {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  type       String   // add_assignment, remove_assignment, modify_assignment, change_shop, change_date
  targetId   String
  changes    String   // JSON string for changes
  createdAt  DateTime @default(now())
}

// Audit log for tracking all data changes
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userEmail   String
  action      String   // create, update, delete, commit, assign, export
  entityType  String   // Car, Shop, Plan, PlanAssignment, Scenario, User
  entityId    String
  entityName  String   @default("") // Human-readable name for the entity
  changes     String   // JSON: { field: { old: value, new: value } }
  metadata    String   @default("{}") // Additional context as JSON
  ipAddress   String   @default("")
  userAgent   String   @default("")
  companyId   String
  createdAt   DateTime @default(now())

  @@index([companyId, entityType, createdAt])
  @@index([userId, createdAt])
}

// Role-based permissions configuration
model RolePermission {
  id           String   @id @default(uuid())
  role         String   // admin, planner, viewer, approver, finance
  permission   String   // entity:action format (e.g., "plan:commit", "shop:edit", "cost:view")
  isGranted    Boolean  @default(true)
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([role, permission, companyId])
}

// Field-level security configuration
model FieldSecurity {
  id            String   @id @default(uuid())
  entityType    String   // Shop, Car, Plan, etc.
  fieldName     String   // laborRate, projectedCost, etc.
  visibleRoles  String   // JSON array of roles that can view
  editableRoles String   // JSON array of roles that can edit
  maskType      String   @default("hidden") // hidden, masked, readonly
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, fieldName, companyId])
}

// Shop performance metrics (calculated periodically)
model ShopPerformance {
  id                   String   @id @default(uuid())
  shopId               String
  periodStart          DateTime // Start of measurement period
  periodEnd            DateTime // End of measurement period
  periodType           String   @default("monthly") // monthly, quarterly, yearly

  // Turn Time / MTTR metrics
  averageTurnTime      Float    @default(0) // Average days from arrival to release
  turnTimeByRepairType String   @default("{}") // JSON: { "qualification": 12, "repair": 18 }

  // On-Time Performance (OTP)
  totalCompleted       Int      @default(0)
  onTimeCompleted      Int      @default(0)
  onTimeRate           Float    @default(0) // Percentage 0-100

  // Dwell Time
  averageDwellTime     Float    @default(0) // Days waiting before work begins

  // Quality metrics
  totalReleased        Int      @default(0)
  reworkCount          Int      @default(0)
  reworkRate           Float    @default(0) // Percentage of cars returning within 90 days

  // Cost metrics
  totalEstimatedCost   Float    @default(0)
  totalActualCost      Float    @default(0)
  costVariance         Float    @default(0) // Percentage difference (positive = over budget)

  // Composite score (weighted calculation)
  performanceScore     Float    @default(0) // 0-100 weighted score

  companyId            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shopId, periodStart, periodEnd, periodType])
  @@index([shopId, periodType, createdAt])
}

// Custom report templates
model ReportTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  entityType      String   // Car, Shop, Plan, Assignment, Scenario
  columns         String   // JSON array of column definitions
  filters         String   @default("[]") // JSON array of saved filter criteria
  sortConfig      String   @default("{}") // JSON: { field, direction }
  groupBy         String   @default("") // Optional grouping field
  outputFormats   String   @default("[\"csv\"]") // JSON array: ["csv", "pdf", "xlsx"]
  isPublic        Boolean  @default(false) // Shared with all company users
  createdById     String
  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Scheduled report jobs
model ScheduledReport {
  id              String    @id @default(uuid())
  name            String
  templateId      String
  schedule        String    // Cron expression: "0 8 * * 1" = 8AM every Monday
  timezone        String    @default("America/Chicago")
  outputFormat    String    @default("pdf") // pdf, csv, xlsx
  recipients      String    // JSON array of email addresses
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String    @default("pending") // pending, success, failed
  lastRunError    String    @default("")
  createdById     String
  companyId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// =============================================================================
// S&OP SCHEDULER MODELS
// =============================================================================

// Shop capacity tracking by month and slot type
model ShopCapacitySlot {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id])
  monthKey    String // "2026-03"
  slotType    String // "qualification", "assignment", "return", "repair"
  capacity    Int    // Total capacity for this slot type
  used        Int    @default(0) // Currently used capacity

  @@unique([shopId, monthKey, slotType])
  @@index([shopId, monthKey])
}

// S&OP Shop Assignment - links railcars to shops within a scenario
// This is THE authoritative assignment table that feeds MasterPlan creation
model SOPAssignment {
  id                  String    @id @default(uuid())
  scenarioId          String
  scenario            Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  carId               String
  car                 Car       @relation(fields: [carId], references: [id])
  shopId              String
  shop                Shop      @relation(fields: [shopId], references: [id])
  reasonsShopped      String    @default("") // Reason(s) for shopping: qualification, repair, maintenance, etc.
  status              String    @default("DRAFT") // DRAFT, PLANNED, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  monthKey            String    // "2026-03"
  scheduledArrival    DateTime?
  scheduledCompletion DateTime?
  actualArrival       DateTime?
  actualDeparture     DateTime?
  estimatedCost       Float?
  actualCost          Float?
  estimatedDays       Int?
  priority            Int       @default(3) // 1=CRITICAL, 2=HIGH, 3=MEDIUM, 4=LOW
  notes               String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([scenarioId, shopId])
  @@index([scenarioId, monthKey])
  @@index([carId])
}

// =============================================================================
// LEASE RELEASE + QUALIFICATION PLANNING ENGINE MODELS
// =============================================================================

// Lease contract tracking for release planning
model LeaseContract {
  id                  String    @id @default(uuid())
  carId               String
  car                 Car       @relation(fields: [carId], references: [id])
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id])
  contractNumber      String    // Unique contract reference
  startDate           DateTime
  endDate             DateTime  // Lease expiration date
  releaseDate         DateTime? // Actual or planned release date
  status              String    @default("active") // active, pending_release, released, renewed, terminated
  commodity           String    @default("") // What the car carries
  releaseReason       String    @default("") // qualification, assignment, return, repair
  nextCustomerId      String?   // New customer if immediate reassignment
  isReleaseConfirmed  Boolean   @default(false) // Customer confirmed release
  releaseDelayDays    Int       @default(0) // Delay from planned release
  notes               String    @default("")
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  qualificationEntries LeaseQualificationEntry[]

  @@unique([contractNumber, companyId])
  @@index([customerId, status])
  @@index([endDate])
  @@index([companyId, status])
}

// Qualification queue entry for planning
model LeaseQualificationEntry {
  id                    String    @id @default(uuid())
  leaseContractId       String?
  leaseContract         LeaseContract? @relation(fields: [leaseContractId], references: [id])
  carId                 String
  car                   Car       @relation(fields: [carId], references: [id])
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id])

  // Release planning
  plannedReleaseDate    DateTime
  actualReleaseDate     DateTime?
  targetQualMonth       String    // YYYY-MM target qualification month

  // Work bundling
  workTypes             String    // JSON array: ["qualification", "assignment", "repair"]
  isBundled             Boolean   @default(false) // Multiple work types bundled
  bundleReason          String    @default("") // Why bundled (immediate reassignment, etc.)

  // Shop assignment
  assignedShopId        String?
  assignedShop          Shop?     @relation(fields: [assignedShopId], references: [id])
  shopAssignmentReason  String    @default("") // Why this shop was selected

  // Status tracking
  queueStatus           String    @default("pending") // pending, queued, scheduled, in_progress, completed, late, cancelled
  priority              Int       @default(3) // 1=critical, 2=high, 3=medium, 4=low

  // Next assignment (if immediate reassignment)
  nextCustomerId        String?
  nextCommodity         String    @default("")

  // Metrics tracking
  originalTargetMonth   String    @default("") // Original planned month
  wasRescheduled        Boolean   @default(false)
  rescheduleCount       Int       @default(0)
  daysInQueue           Int       @default(0)

  notes                 String    @default("")
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  planEvents            QualificationPlanEvent[]

  @@index([companyId, queueStatus])
  @@index([targetQualMonth])
  @@index([carId])
  @@index([customerId])
}

// Scheduled events for qualification planning
model QualificationPlanEvent {
  id                    String    @id @default(uuid())
  qualEntryId           String
  qualEntry             LeaseQualificationEntry @relation(fields: [qualEntryId], references: [id], onDelete: Cascade)
  scenarioId            String?   // Optional: link to scenario for what-if analysis

  // Event details
  eventType             String    // release, transport, shop_arrival, qual_start, qual_complete, assignment_start, departure
  plannedDate           DateTime
  actualDate            DateTime?
  status                String    @default("planned") // planned, confirmed, completed, missed, cancelled

  // Location/shop info
  shopId                String?
  shopName              String    @default("")
  locationFrom          String    @default("")
  locationTo            String    @default("")

  // Duration and cost
  estimatedDays         Int       @default(0)
  actualDays            Int?
  estimatedCost         Float     @default(0)
  actualCost            Float?

  notes                 String    @default("")
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([qualEntryId, eventType])
  @@index([scenarioId])
  @@index([plannedDate])
}

// Qualification Planning Scenario (for what-if analysis)
model QualificationScenario {
  id                    String    @id @default(uuid())
  name                  String
  description           String    @default("")
  scenarioType          String    // base, late_release, capacity_shift, custom
  status                String    @default("draft") // draft, running, completed, approved, archived

  // Scenario parameters
  planningHorizonMonths Int       @default(6) // 4-6 months planning window
  lateReleasePercent    Float     @default(0) // % of cars that slip (for late_release scenario)
  capacityAdjustment    String    @default("{}") // JSON: shopId -> adjustment %

  // Base scenario reference
  parentScenarioId      String?
  parentScenario        QualificationScenario? @relation("ScenarioVersions", fields: [parentScenarioId], references: [id])
  childScenarios        QualificationScenario[] @relation("ScenarioVersions")

  // Results (JSON stored metrics)
  metricsJson           String    @default("{}") // Full metrics breakdown
  summaryJson           String    @default("{}") // Summary for comparison

  // Approval workflow
  isApproved            Boolean   @default(false)
  approvedBy            String?
  approvedAt            DateTime?

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  planAssignments       QualificationPlanAssignment[]

  @@index([companyId, status])
  @@index([scenarioType])
}

// Qualification Plan Assignment (car-to-shop within a scenario)
model QualificationPlanAssignment {
  id                    String    @id @default(uuid())
  scenarioId            String
  scenario              QualificationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  carId                 String
  shopId                String

  // Planning details
  monthKey              String    // YYYY-MM
  workTypes             String    // JSON array of work types
  priority              Int       @default(3)

  // Bundling info
  isBundled             Boolean   @default(false)
  bundleGroupId         String?   // Group ID for bundled assignments

  // Scheduling
  scheduledArrival      DateTime?
  scheduledCompletion   DateTime?
  estimatedDays         Int       @default(14)
  estimatedCost         Float     @default(0)

  // Customer info
  currentCustomerId     String?
  nextCustomerId        String?   // For immediate reassignment

  // Status
  status                String    @default("planned") // planned, confirmed, in_progress, completed
  notes                 String    @default("")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([scenarioId, monthKey])
  @@index([scenarioId, shopId])
  @@index([carId])
}

// Generated Plan Documents (Team Plans and Customer PDFs)
model QualificationPlanDocument {
  id                    String    @id @default(uuid())
  scenarioId            String
  documentType          String    // team_plan, customer_schedule, summary_report, comparison_report
  title                 String
  description           String    @default("")

  // Document content
  contentMarkdown       String    // Markdown content for rendering
  contentJson           String    @default("{}") // Structured data for PDF generation

  // PDF generation status
  pdfGenerated          Boolean   @default(false)
  pdfUrl                String    @default("") // Path to generated PDF
  pdfGeneratedAt        DateTime?

  // Target audience
  targetCustomerId      String?   // For customer-specific schedules
  targetShopId          String?   // For shop-specific plans

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([scenarioId, documentType])
  @@index([companyId])
}

// =============================================================================
// MASTER PLAN MODELS
// =============================================================================
// The MasterPlan is the single source of truth for the official, approved plan
// that feeds: Customer PDFs, Planning team dashboards, Shop work orders, All reporting
// =============================================================================

// MasterPlan - The approved, authoritative plan for a fiscal year
// Workflow: draft → under_review → approved → active → archived
model MasterPlan {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])

  planName       String   // e.g. "2026 Qualification Plan – Final v2"
  fiscalYear     Int      // e.g. 2026
  version        Int      @default(1) // Auto-increments for same fiscalYear

  // Status workflow: draft → under_review → approved → active → archived
  // - draft: Initial creation, can be edited freely
  // - under_review: Submitted for approval, locked for edits
  // - approved: Approved by authorized user, but not yet active
  // - active: The current operative plan for this fiscal year
  // - archived: Superseded by a newer version or closed fiscal year
  status         String   @default("draft")

  // Link to the scenario this plan was generated from
  baseScenarioId String?
  baseScenario   Scenario? @relation(fields: [baseScenarioId], references: [id])

  // Approval tracking
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?    @relation("MasterPlanApprover", fields: [approvedById], references: [id])

  // Plan coverage period
  validFrom      DateTime // First month covered (e.g., 2026-01-01)
  validTo        DateTime // Last month covered (e.g., 2026-12-31)

  // Commitment records for each car assignment
  commitments    MasterPlanCommitment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Constraints:
  // - Unique combination of company + fiscal year + version
  // - Only one "active" plan per company per fiscal year (enforced at service level)
  @@unique([companyId, fiscalYear, version])
  @@index([companyId, status])
  @@index([companyId, validFrom])
}

// MasterPlanCommitment - Individual car assignment within a MasterPlan
// Represents a committed shop visit for a specific car
model MasterPlanCommitment {
  id              String    @id @default(uuid())
  masterPlanId    String
  masterPlan      MasterPlan @relation(fields: [masterPlanId], references: [id], onDelete: Cascade)

  // Car being scheduled
  carId           String
  car             Car       @relation(fields: [carId], references: [id])

  // Shop where work will be performed
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id])

  // Customer who owns/leases the car
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])

  // Scheduling details
  scheduledMonth  String    // YYYY-MM format for the target month
  plannedArrival  DateTime? // Specific planned arrival date (if known)
  plannedRelease  DateTime? // Specific planned release date (if known)

  // Work specification - Reasons for shopping this car
  // JSON array as string: ["qualification", "assignment", "repair"]
  // Qualification is priority/main cost driver when bundled
  reasonsShopped  String    // Standardized name across all entities
  isBundled       Boolean   @default(false) // Multiple work types bundled together

  // Cost and priority
  estimatedCost   Float?    // Estimated total cost for this commitment
  priority        Int       @default(3) // 1=CRITICAL, 2=HIGH, 3=MEDIUM, 4=LOW, 5=DEFERRED

  // Commitment status workflow:
  // - committed: Locked in the plan, not yet operationally scheduled
  // - scheduled: Shop has been notified, dates confirmed
  // - in_transit: Car is en route to shop
  // - arrived: Car has arrived at shop
  // - in_progress: Work is underway
  // - released: Work complete, car released from shop
  status          String    @default("committed")

  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Constraints:
  // - Each car can only appear once per master plan
  // - Index for shop scheduling queries (shop + month)
  @@unique([masterPlanId, carId])
  @@index([shopId, scheduledMonth])
  @@index([customerId])
  @@index([status])
}

// =============================================================================
// WEBHOOK ALERTING
// =============================================================================

model WebhookConfig {
  id          String   @id @default(uuid())
  name        String
  type        String   // slack, teams, custom
  url         String
  isActive    Boolean  @default(true)
  categories  String   // JSON array: ["security", "capacity", "performance", "system", "data_change"]
  severities  String   // JSON array: ["info", "warning", "critical"]
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, isActive])
}

// =============================================================================
// PUBLIC API KEYS
// =============================================================================

model ApiKey {
  id              String    @id @default(uuid())
  name            String
  keyHash         String    @unique // SHA-256 hash of the full key
  keyPrefix       String    // First 12 chars for display (chr_live_xxx)
  permissions     String    // JSON array of permissions
  rateLimit       Int       @default(1000) // Requests per window
  rateLimitWindow Int       @default(3600) // Window in seconds (default 1 hour)
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  companyId       String
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, isActive])
  @@index([keyHash])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String    // info, success, warning, error, action_required
  category    String    // assignment, approval, alert, system, report
  title       String
  message     String
  link        String?   // Optional link to related resource
  metadata    String    @default("{}") // JSON: additional data
  isRead      Boolean   @default(false)
  readAt      DateTime?
  expiresAt   DateTime? // Optional expiration for time-sensitive notifications
  companyId   String
  createdAt   DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@index([companyId, createdAt])
}

// =============================================================================
// GOLD STANDARD CAR FLOW PLANNING MODELS
// =============================================================================

// Weekly Capacity - Time-series capacity tracking per shop per week
model WeeklyCapacity {
  id              String    @id @default(uuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  weekStartDate   DateTime  // Monday of the week
  weekKey         String    // Format: YYYY-Www (e.g., 2025-W48)

  // Capacity by work type
  qualCapacity    Int       @default(0)
  assignCapacity  Int       @default(0)
  returnCapacity  Int       @default(0)
  repairCapacity  Int       @default(0)
  totalCapacity   Int       @default(0)

  // Used capacity tracking
  qualUsed        Int       @default(0)
  assignUsed      Int       @default(0)
  returnUsed      Int       @default(0)
  repairUsed      Int       @default(0)
  totalUsed       Int       @default(0)

  // Locked status
  isLocked        Boolean   @default(false)
  lockedAt        DateTime?
  lockedById      String?

  notes           String    @default("")
  companyId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Audit trail for changes
  capacityAudits  CapacityAudit[]

  @@unique([shopId, weekKey])
  @@index([shopId, weekStartDate])
  @@index([companyId, weekKey])
}

// Capacity Audit - Inline auditing for capacity changes with justification
model CapacityAudit {
  id                String    @id @default(uuid())
  weeklyCapacityId  String
  weeklyCapacity    WeeklyCapacity @relation(fields: [weeklyCapacityId], references: [id], onDelete: Cascade)

  // Change details
  fieldName         String    // qualCapacity, assignCapacity, etc.
  previousValue     Int
  newValue          Int

  // Required justification
  justification     String    // User must provide reason for change
  changeCategory    String    // demand_increase, resource_constraint, maintenance, seasonal, emergency, other

  // Who made the change
  changedById       String
  changedByEmail    String

  // Approval workflow (optional)
  requiresApproval  Boolean   @default(false)
  approvedById      String?
  approvedAt        DateTime?
  approvalStatus    String    @default("auto_approved") // pending, approved, rejected, auto_approved

  companyId         String
  createdAt         DateTime  @default(now())

  @@index([weeklyCapacityId, createdAt])
  @@index([companyId, createdAt])
}

// Shop History - Soft-delete and versioning for historical data integrity
model ShopHistory {
  id                String    @id @default(uuid())
  shopId            String    // Reference to the current shop

  // Historical snapshot
  name              String
  code              String
  location          String
  city              String
  state             String
  region            String
  network           String
  isAitxInternal    Boolean
  tankQualified     Boolean
  capacity          Int

  // Versioning
  version           Int       @default(1)
  validFrom         DateTime  // When this version became active
  validTo           DateTime? // When this version was superseded (null if current)

  // Soft-delete tracking
  status            String    @default("active") // active, inactive, renamed, merged
  previousShopId    String?   // Link to previous shop if renamed
  successorShopId   String?   // Link to new shop if renamed
  changeReason      String    @default("") // Reason for change/deactivation

  // Who made the change
  changedById       String?
  changedByEmail    String    @default("")

  companyId         String
  createdAt         DateTime  @default(now())

  @@index([shopId, validFrom])
  @@index([companyId, status])
  @@index([code, companyId])
}

// Master Plan Version - Versioned master plans with lock/unlock tracking
model MasterPlanVersion {
  id                String    @id @default(uuid())
  masterPlanId      String

  // Version info
  versionNumber     String    // Format: v2025.11.1 (year.month.revision)
  versionLabel      String    @default("") // Optional human-readable label

  // Status workflow
  status            String    @default("draft") // draft, pending_review, locked, published, superseded

  // Lock tracking
  isLocked          Boolean   @default(false)
  lockedAt          DateTime?
  lockedById        String?
  lockedByEmail     String    @default("")
  lockReason        String    @default("")

  // Publication tracking
  publishedAt       DateTime?
  publishedById     String?
  publishedByEmail  String    @default("")

  // Snapshot of the plan at this version
  planSnapshot      String    // JSON: full plan data at time of version
  commitmentCount   Int       @default(0)
  totalCars         Int       @default(0)

  // Downstream push tracking
  pushedToScheduling   Boolean   @default(false)
  pushedToSchedulingAt DateTime?
  pushResponse         String    @default("{}") // JSON: response from downstream

  companyId         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([masterPlanId, versionNumber])
  @@index([companyId, status])
}

// Integration Log - API/Webhook monitoring for Master Plan publication
model IntegrationLog {
  id              String    @id @default(uuid())

  // Integration details
  integrationType String    // webhook, api_call, data_sync
  endpoint        String    // URL or endpoint called
  method          String    // POST, PUT, GET, etc.

  // Request/Response
  requestPayload  String    @default("{}") // JSON: request body (sanitized)
  responseStatus  Int       // HTTP status code
  responseBody    String    @default("{}") // JSON: response body (sanitized)

  // Timing
  startedAt       DateTime
  completedAt     DateTime?
  durationMs      Int       @default(0)

  // Status
  status          String    @default("pending") // pending, success, failed, timeout, retrying
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  errorMessage    String    @default("")

  // Context
  triggerAction   String    // master_plan_publish, allocation_update, capacity_change
  entityType      String    // MasterPlan, WeeklyCapacity, etc.
  entityId        String

  // Who triggered
  triggeredById   String?
  triggeredByEmail String   @default("")

  companyId       String
  createdAt       DateTime  @default(now())

  @@index([companyId, integrationType, createdAt])
  @@index([entityType, entityId])
  @@index([status, createdAt])
}

// Import Session - Track import workflow with 3-step validation
model ImportSession {
  id              String    @id @default(uuid())

  // Session info
  sessionType     String    // cars, shops, capacity, allocations
  fileName        String
  fileSize        Int       @default(0)

  // Workflow status
  status          String    @default("uploaded") // uploaded, validating, preview, mapping, confirmed, importing, completed, failed
  currentStep     Int       @default(1) // 1: Upload, 2: Preview/Validate, 3: Confirm Mapping

  // Validation results
  totalRows       Int       @default(0)
  validRows       Int       @default(0)
  errorRows       Int       @default(0)
  warningRows     Int       @default(0)

  // Errors and warnings (JSON arrays)
  validationErrors  String  @default("[]") // JSON: [{row, field, message, severity}]
  validationWarnings String @default("[]")

  // Field mapping
  detectedHeaders   String  @default("[]") // JSON: detected column headers
  fieldMappings     String  @default("{}") // JSON: {sourceField: targetField}
  unmappedFields    String  @default("[]") // JSON: fields that couldn't be mapped

  // Preview data
  previewData       String  @default("[]") // JSON: first N rows for preview

  // Import results
  importedCount     Int     @default(0)
  updatedCount      Int     @default(0)
  skippedCount      Int     @default(0)

  // Error report
  errorReportUrl    String  @default("") // Path to downloadable error CSV

  // Timestamps
  uploadedAt        DateTime @default(now())
  validatedAt       DateTime?
  mappedAt          DateTime?
  confirmedAt       DateTime?
  completedAt       DateTime?

  // User
  uploadedById      String
  uploadedByEmail   String
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, status])
  @@index([uploadedById, createdAt])
}

// Invalidated JWT Tokens - For token blacklisting on logout
model InvalidatedToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique // SHA-256 hash of the JWT token
  userId      String
  expiresAt   DateTime // When the token would have expired naturally
  invalidatedAt DateTime @default(now())
  reason      String   @default("logout") // logout, password_change, security_breach, admin_revoke

  @@index([expiresAt]) // For cleanup job
  @@index([tokenHash])
}

// Rate Limit Entry - For tracking API rate limits in database (multi-instance support)
model RateLimitEntry {
  id          String   @id @default(uuid())
  identifier  String   // User ID, IP address, or API key ID
  endpoint    String   // Route pattern being limited
  windowStart DateTime // Start of the current rate limit window
  requestCount Int     @default(1)

  @@unique([identifier, endpoint, windowStart])
  @@index([windowStart]) // For cleanup of old entries
}

// Allocation Override - Track user overrides in allocation matrix
model AllocationOverride {
  id                String    @id @default(uuid())

  // Allocation target
  shopId            String
  weekKey           String    // YYYY-Www format
  workType          String    // qualification, assignment, return, repair

  // Override details
  originalValue     Int
  overrideValue     Int

  // Justification (required)
  justification     String
  overrideReason    String    // rebalancing, customer_request, emergency, capacity_issue, other

  // Related cars (optional bulk selection)
  relatedCarIds     String    @default("[]") // JSON array of car IDs
  carCount          Int       @default(0)

  // Status
  status            String    @default("pending") // pending, applied, reverted
  appliedAt         DateTime?
  revertedAt        DateTime?

  // User tracking
  overriddenById    String
  overriddenByEmail String

  // Approval (if over threshold)
  requiresApproval  Boolean   @default(false)
  approvalThreshold Int       @default(10) // Override > N cars requires approval
  approvedById      String?
  approvedAt        DateTime?
  approvalStatus    String    @default("auto_approved") // pending, approved, rejected, auto_approved

  companyId         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shopId, weekKey])
  @@index([companyId, status])
}
